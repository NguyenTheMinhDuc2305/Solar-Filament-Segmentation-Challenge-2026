# Per-machine credentials. Copy to .env and fill in YOUR OWN values.
# .env is gitignored on purpose: every teammate trains on their own Kaggle
# account, and only shared_memory/ is shared through git.

# Kaggle API token (new-style KGAT_...). Generate at:
#   https://www.kaggle.com/settings/api  ->  "Create New Token"
# Your Kaggle username is derived from this token at runtime - do not set it manually.
KAGGLE_API_TOKEN=

# GitHub PAT with `repo` scope. Used to push code and, inside the Kaggle
# notebook, to clone this repo. Store the same value as a Kaggle Secret named
# GITHUB_TOKEN so notebooks can clone (see notebooks/README.md).
GITHUB_TOKEN=

# Optional display name used in shared_memory/RESULTS.md so the team can tell
# whose run produced a number. Defaults to your Kaggle username.
TEAM_MEMBER=
